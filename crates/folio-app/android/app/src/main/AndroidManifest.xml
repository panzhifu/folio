<?xml version="1.0" encoding="utf-8" ?>
<!--
  AndroidManifest.xml for the GPUI Mobile Android Example.

  This manifest declares a NativeActivity that loads the Rust shared library
  compiled from the `android_app` example.  The library name is injected via
  the `nativeLibraryName` manifest placeholder defined in build.gradle.kts.

  Key points:
    - NativeActivity is used instead of a regular Activity so the entire
      application lifecycle is driven from native (Rust) code.
    - The `android.app.lib_name` meta-data tells NativeActivity which .so
      to dlopen.  It must match the cdylib / example output name WITHOUT
      the `lib` prefix or `.so` suffix.
    - `configChanges` prevents the activity from being recreated on common
      configuration changes (rotation, keyboard, screen size).  The Rust
      code handles these via NDK callbacks instead.
    - Hardware acceleration is enabled for Vulkan / GPU compositing.
    - The theme hides the title bar and status bar for a fullscreen
      immersive experience.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibration permission -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      In-app updates: after Folio downloads an APK and checks its SHA-256, it hands the
      file to the system installer. That needs this permission; the actual install is
      still confirmed by the reader in the system dialog. Not required to *launch* the
      installer page (openInstallPermissionSettings) — that one works without it.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      整机扫描（书架上的「扫描」）要读共享存储里的书。请求走 permission_handler
      的 MANAGE_EXTERNAL_STORAGE（「所有文件访问」，fork gpui-pre-mobile 29f19d3
      暴露的 API）：它不是运行时权限，而是带读者去系统设置页开开关。没授权时
      扫描照跑，但 roots 只剩应用自己的目录；读不了的地方计入清单页的「跳过 N 处」，
      这是设计好的退化路径。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Saving a reader image into the gallery needs a write grant only on API 26–28;
         API 29+ goes through MediaStore with RELATIVE_PATH and needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Camera feature (optional — app works without camera) -->

    <!-- Vulkan feature declaration.
         `required="false"` allows the app to fall back to OpenGL ES on
         devices without Vulkan support. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />

    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />

    <!-- GPU hardware acceleration is required for wgpu rendering. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Touchscreen support (virtually all Android devices). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <!--
      合成朗读（听书）要绑到系统 TTS 引擎。API 30+ 的包可见性规则会把别的应用的
      service 藏起来，`TextToSpeech` 因此看不见、也列不出非默认引擎，所以按官方
      做法显式声明这一条意图。

      一条实测更正，别再拿旧说法当依据：2026-10-19 在 Meizu 20 / Android 16 上，
      **没加这一条也绑上了**（logcat：`Sucessfully bound to com.google.android.tts`），
      因为 `tts_default_synth` 指向的那个默认引擎不受可见性限制。所以这条的作用范围是
      「非默认引擎与音色清单」，不是「有没有声音」；留着它是因为换 ROM、换引擎、
      或读者改过默认引擎之后答案就不同了，而我们不打算在运行时去猜那些。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Folio"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
        android:enableOnBackInvokedCallback="true"
    >

        <!--
          GpuiActivity extends NativeActivity and integrates the AndroidX
          SplashScreen API.  The splash screen is held visible until the
          Rust native library signals readiness via NATIVE_INITIALIZED.

          The Android framework loads the specified native library and calls
          ANativeActivity_onCreate(), which is defined in gpui_mobile::android::jni.
          The spawned Rust thread calls gpui_android_main() (defined in the
          android_app example) to start the application.
        -->
        <!-- Folio's own entry. The Java bridge classes under dev.gpui.mobile are a
             copy of the fork's example and are looked up by name from Rust, so keep
             this file in sync when bumping gpui-pre-mobile.

             `adjustNothing`: the soft keyboard overlays the window instead of
             resizing it. Since the fork separates the system-bar insets (safe
             area) from the IME (`nativeWindowInsets`), the bottom navigation bar
             no longer moves when the keyboard opens.

             `enableOnBackInvokedCallback`: required for GpuiInputActivity's
             OnBackInvokedDispatcher callback to fire on Android 13+. Without it
             the edge-swipe back gesture never reaches the app.

             `screenOrientation="portrait"`：不是「不让界面转」这一条审美选择，是拔掉一个
             系统副作用。原先的 `unspecified` 等于告诉系统「这个窗口两种方向都吃」，而
             MEIZU 20 / Android 16 实测：folio 一到前台（冷启动、热恢复都算），系统就把
             `system/accelerometer_rotation` 写成 1 —— 读者的「自动旋转」被应用替他打开了，
             而 folio 自己拿不到 `WRITE_SECURE_SETTINGS`，那一笔不是它写的。锁成 portrait 后
             窗口不再声明可转，那个开关就没人碰。手机这一档本来也只有竖屏一套版式：横屏
             宽度 853dp 会跨过 SizeClass 的 Expanded 阈值 840dp，整套桌面版式压到手机上，
             正文还要整章重排。 -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustNothing"
        >

            <!-- The native library name WITHOUT the "lib" prefix and ".so" suffix.
                 This is set via manifestPlaceholders in build.gradle.kts. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <!-- Mark this activity as the main launcher entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link intent filter for custom URL scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="folio" />
            </intent-filter>
        </activity>
        <!-- GPUI's Android path prompt (cx.prompt_for_paths) starts this Activity by
             name via JNI. An unregistered Activity is an ActivityNotFoundException at
             tap time, so this entry is part of the Rust side's contract, not optional
             chrome. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPathPicker"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <!-- Transparent helper Activity for file/image picker results. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Transparent helper Activity for runtime permission requests. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Transparent helper Activity for biometric authentication (BiometricPrompt). -->
        <activity
            android:name="dev.gpui.mobile.GpuiAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

        <!-- Shares a reader image out through a content:// URI. The bytes land in
             cache/share/ (see GpuiSystemUi.shareImage) and the path list lives in
             res/xml/file_paths.xml. A raw file:// URI would throw on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
        >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
            />
        </provider>

    </application>

</manifest>
