{{#each used_by}}
  - {{{this.crate.name}}} {{{this.crate.version}}}{{#if this.crate.checksum}}  (checksum {{{this.crate.checksum}}}){{/if}}
{{/each}}

{{{this.text}}}

{{/each}}
